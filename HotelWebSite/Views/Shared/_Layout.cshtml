                @foreach (var ro in blogs.OrderByDescending(b => b.PublishedDate).Take(3))
                {
                    string detailUrl = Url.RouteUrl("postDetailRoute", new { postId = ro.PostId, slug = ro.Slug });

                    <div class="item slide-box wow fadeInUp delay-04s">
                        <div class="blog-3">
                            <div class="blog-image">
                                <img src="~/uploads/blog/@ro.DefaultImage"
                                     alt="@ro.Title"
                                     class="img-fluid w-100" />
                                <div class="date-box">@(ro.PublishedDate?.ToString("dd MMM") ?? "N/A")</div>
                                <div class="post-meta clearfix">
                                    <span><a href="@detailUrl"><i class="fa fa-user"></i></a>  @ro.Author</span>
                                </div>
                            </div>
                            <div class="detail">
                                <h4>
                                    <a href="@detailUrl" style="color:black">@ro.Title</a>
                                </h4>
                                <p>@ro.ShortDescriptions</p>
                                <a href="@detailUrl" class="read-more">Read More...</a>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
